# 运行时与产物（不进版本库）
# 源码副本的便携 Python 解压到 runtime/；交付包里统一叫 python/（由打包脚本生成）
runtime/*
!runtime/README.md
dist/
tests/node_modules/
staticfiles/

# 离线 wheel 仓库（由 ./start.sh wheel:download 生成）
wheelhouse/

# 本地环境配置（可能含密钥；交付包只带 .env.example）
.env

# 运行日志
logs/

# 运行期数据（证书私钥、台账、日志、快照都在里面，绝不入库）
data/
*.db
*.db-wal
*.db-shm
admin_password.txt

# Python
__pycache__/
*.pyc

# IDE / AI 工具 / 系统
.workbuddy/
.codebuddy/
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.baiduyun.uploading.cfg
