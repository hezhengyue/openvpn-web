# ===================== 🌟 运行模式（二选一，同一份代码） =====================
# False = Docker 全家桶：Nginx + PostgreSQL + Redis + Celery + Gunicorn
# True  = 裸机便携模式：便携 Python 3.12 + SQLite(WAL) + WhiteNoise + Waitress
STANDALONE=False

# 裸机 HTTP 内网访问设 false；公网/带 TLS 终止设 true
# 注意：该开关不再与 DEBUG 绑定；裸机命令会强制 USE_HTTPS=false，
# 除非显式设置 STANDALONE_USE_HTTPS=true（见下方裸机专用段）
USE_HTTPS=true

# ===================== 🔐 基础安全 =====================
# 示例值，正式部署必须替换（生产环境中 django-insecure 前缀会被启动拦截）
SECRET_KEY=Z2tDWijnp7UYE57EL2K3Crl00mEkSW-KHqKhbJmrMjM=
PROJECT_NAME=docker-django
DEBUG=false

# 可写 host 或 host:port；ALLOWED_HOSTS 自动去端口，CSRF_TRUSTED_ORIGINS 保留端口
# 裸机 8800 端口示例：HOSTS=10.1.0.90:8800
HOSTS=10.1.0.90

# ===================== django 超级用户 =====================
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=ChangeMe_Admin_2026

# ===================== 🗄️ 数据库（STANDALONE=False 时生效） =====================
# 生产环境禁止使用默认弱口令 Postgres1234 / Redis1234
# 外部独立库 / 云 RDS：填 POSTGRES_HOST=外部地址，端口按实际改 POSTGRES_PORT
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_Postgres_2026
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# ===================== 🚀 缓存 / 队列（STANDALONE=False 时生效） =====================
# 外部 Redis 实例：填 REDIS_HOST=外部地址
REDIS_PASSWORD=ChangeMe_Redis_2026
# REDIS_HOST=redis
# REDIS_PORT=6379

# ===================== 📦 裸机便携模式专用（STANDALONE=True 时生效） =====================
# locmem（默认，单进程 Waitress）或 file（多进程时用文件缓存）
STANDALONE_CACHE=locmem
# 前置本机反代（TRUST_LOCAL_PROXY=true）时建议绑定 127.0.0.1，
# 避免外部直连端口伪造 X-Forwarded-Proto / IP 头
STANDALONE_HOST=0.0.0.0
STANDALONE_PORT=8800
STANDALONE_THREADS=8
# 裸机前面若已有 HTTPS 终止（自己的 nginx / 负载均衡），设 true 保留 Secure Cookie
# 默认 false：standalone:* 命令会忽略上方的 USE_HTTPS=true，按纯 HTTP 处理
# STANDALONE_USE_HTTPS=true
# DATA_DIR 默认项目根 data/，SQLite 与文件缓存都在这里
# RUNTIME_DIR 是统一可写区总开关：设置后，未单独指定的运行时目录自动落到
#   RUNTIME_DIR/{data,data/cache,staticfiles,media,logs}。
# 用于「项目根只读、只有运行时目录可写」的部署；单项 *DIR 变量优先级更高。
# RUNTIME_DIR=/var/lib/openvpn-web

# ===================== 🔐 安全 / 会话 / Axes（两种模式共用） =====================
# 连续失败锁定阈值与冷却时间，本项目默认 5 次 / 10 分钟
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=10
# 后台不允许被任何页面嵌框（默认 DENY，无需修改）
# X_FRAME_OPTIONS=DENY
# 审计保留天数（清理命令：manage.py audit_purge --days N）
# AUDIT_RETENTION_DAYS=180
# 认证事件自动捕获白名单，逗号分隔；本项目只留 lockout（登录/退出/失败由业务侧记）
# AUDIT_CAPTURE_EVENTS=lockout
# 无操作人时的兜底名字，默认留空
# AUDIT_FALLBACK_ACTOR=
# 会话时长（秒），默认 1200
# SESSION_COOKIE_AGE=1200
# 单次上传上限（MB），默认 50
# MAX_UPLOAD_MB=50
# 既有前端传 X-CSRF-Token 时用下面这个头名对齐（Django 原生为 HTTP_X_CSRFTOKEN）
# CSRF_HEADER_NAME=HTTP_X_CSRF_TOKEN
# 裸机前置本机 Nginx/Caddy 做 TLS 终止时设为 true：
#   1) request.is_secure() 正确识别 HTTPS；2) 只信任来自 127.0.0.1/::1 的转发头取真实 IP。
# 默认跟随 STANDALONE_USE_HTTPS；公网直连务必保持 false。
# TRUST_LOCAL_PROXY=false

# ===================== 📧 邮件：默认关闭，未配置也能启动 =====================
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_PROTOCOL=ssl
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ===================== 📦 裸机离线依赖（可选） =====================
# ./start.sh wheel:download 默认输出到 wheelhouse/；
# standalone:install 检测到 *.whl 后自动 --no-index 安装。
# 本项目交付包已随包带 vendor/wheels，可用下面的值直接离线安装源码副本。
WHEEL_DIR=vendor/wheels
# 目标平台，默认 manylinux2014_x86_64；native 表示按构建机当前平台
# WHEEL_PLATFORM=manylinux2014_x86_64
# WHEEL_PYTHON=3.12
